{
  "name": "shanghai-chengkao-70d",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@10.30.3",
  "scripts": {
    "dev": "pnpm --parallel --filter @shck/server --filter @shck/web dev",
    "dev:web": "pnpm --filter @shck/web dev",
    "dev:server": "pnpm --filter @shck/server start:dev",
    "build": "pnpm build:shared && pnpm --filter @shck/server build && pnpm --filter @shck/web build",
    "build:shared": "pnpm --filter @shck/shared build",
    "db:migrate": "pnpm build:shared && pnpm --filter @shck/server migration:run",
    "db:seed": "pnpm build:shared && pnpm --filter @shck/server seed",
    "db:papers:sync": "pnpm build:shared && pnpm --filter @shck/server papers:sync",
    "lint": "pnpm --recursive run lint"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.29.1",
    "@typescript-eslint/parser": "^8.29.1",
    "eslint": "^9.25.1",
    "prettier": "^3.5.3",
    "typescript": "^5.8.3"
  }
}
